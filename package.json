    "test:routes": "node scripts/verify-public-routes.mjs",
    "test:commerce": "node scripts/verify-commerce-contract.mjs",
    "test:shipping": "node scripts/verify-shipping-calculator.mjs",
    "test:jne": "node scripts/verify-jne-official-client.mjs",
