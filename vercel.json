{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/finance-app.js": {
      "includeFiles": "apps/finance/index.html"
    }
  },
  "crons": [
    {
      "path": "/api/commerce-maintenance",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/src/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.nix-p.com" }],
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "finance.nix-p.com" }],
      "destination": "/finance",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/payments/midtrans-token",
      "destination": "/api/checkout?commerceAction=midtrans-token"
    },
    {
      "source": "/api/webhooks/midtrans",
      "destination": "/api/checkout?commerceAction=midtrans-webhook"
    },
    {
      "source": "/api/order-status",
      "destination": "/api/checkout?commerceAction=order-status"
    },
    {
      "source": "/api/commerce-maintenance",
      "destination": "/api/checkout?commerceAction=maintenance"
    },
    {
      "source": "/api/admin/orders",
      "destination": "/api/admin/store?commerceAction=orders"
    },
    {
      "source": "/api/admin/shipping",
      "destination": "/api/admin/store?commerceAction=shipping-rates"
    },
    {
      "source": "/api/admin/catalog-sync",
      "destination": "/api/admin/store?commerceAction=catalog-sync"
    },
    {
      "source": "/api/catalog-sync",
      "destination": "/api/admin/store?commerceAction=catalog-sync"
    },
    {
      "source": "/api/admin/backups",
      "destination": "/api/admin/store?commerceAction=backups"
    },
    {
      "source": "/login",
      "has": [{ "type": "host", "value": "finance.nix-p.com" }],
      "destination": "/api/finance-app?financePath=/login"
    },
    {
      "source": "/logout",
      "has": [{ "type": "host", "value": "finance.nix-p.com" }],
      "destination": "/api/finance-app?financePath=/logout"
    },
    {
      "source": "/finance",
      "has": [{ "type": "host", "value": "finance.nix-p.com" }],
      "destination": "/api/finance-app?financePath=/"
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "finance.nix-p.com" }],
      "destination": "/api/finance-app?financePath=/"
    },
    {
      "source": "/product/:productId",
      "destination": "/api/catalog?action=product-redirect&id=:productId"
    },
    {
      "source": "/records/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/objects/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/apparel/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/accessories/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/publishing/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/artists/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin/shipping",
      "destination": "/admin/shipping/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/records",
      "destination": "/index.html"
    },
    {
      "source": "/objects",
      "destination": "/index.html"
    },
    {
      "source": "/apparel",
      "destination": "/index.html"
    },
    {
      "source": "/accessories",
      "destination": "/index.html"
    },
    {
      "source": "/accesories",
      "destination": "/index.html"
    },
    {
      "source": "/publishing",
      "destination": "/index.html"
    },
    {
      "source": "/artists",
      "destination": "/index.html"
    },
    {
      "source": "/blog",
      "destination": "/index.html"
    },
    {
      "source": "/request-item",
      "destination": "/index.html"
    },
    {
      "source": "/make-an-offer",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/shipping-returns",
      "destination": "/index.html"
    },
    {
      "source": "/international-order",
      "destination": "/index.html"
    },
    {
      "source": "/terms-of-use",
      "destination": "/index.html"
    },
    {
      "source": "/cart",
      "destination": "/index.html"
    },
    {
      "source": "/order-status",
      "destination": "/index.html"
    }
  ]
}
